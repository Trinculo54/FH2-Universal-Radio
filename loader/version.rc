// FH2 Mod Loader version info. The mods read this to tell whether the
// installed loader is older than the one they ship with.
#include <winver.h>
#include "fh2_version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     LOADER_V1,LOADER_V2,LOADER_V3,0
 PRODUCTVERSION  LOADER_V1,LOADER_V2,LOADER_V3,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_DLL
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Trinculo54"
            VALUE "FileDescription",  "FH2 Mod Loader (loads fh2-mods\\*.dll; forwards D3DCompiler to System32)"
            VALUE "FileVersion",      LOADER_VERSION_STR
            VALUE "InternalName",     "FH2 Mod Loader"
            VALUE "OriginalFilename", "d3dcompiler_47.dll"
            VALUE "ProductName",      "FH2 Mod Loader"
            VALUE "ProductVersion",   LOADER_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
